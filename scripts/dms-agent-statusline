#!/usr/bin/env bash
# dms-agent-statusline — feeds rate-limit / context data to the island, then
# chains to the user's original status line (saved by dms-agent-install) so
# the terminal output is unchanged.
input=$(cat)
state=${XDG_STATE_HOME:-$HOME/.local/state}/dms-agent

payload=$(jq -c '{ev:"usage", sid:(.session_id // ""),
    model:(.model.display_name // ""),
    ctx:(.context_window.used_percentage // -1),
    five:(.rate_limits.five_hour // null),
    seven:(.rate_limits.seven_day // null)}' <<<"$input" 2>/dev/null || true)
# only ping the island when something actually changed — this script runs on
# every statusline refresh
if [ -n "$payload" ] && [ "$payload" != "$(cat "$state/last-usage" 2>/dev/null)" ]; then
    mkdir -p "$state"
    printf '%s' "$payload" > "$state/last-usage"
    (dms ipc call island agentEvent "$payload" >/dev/null 2>&1 &)
fi

orig=$(cat "$state/statusline-orig" 2>/dev/null || true)
[ -n "$orig" ] && printf '%s' "$input" | bash -c "$orig"
exit 0

#!/usr/bin/env bash
# dms-agent-install [--uninstall] — wire Claude Code into the Dynamic Island.
#
# Idempotent: strips any previous dms-agent entries before adding the current
# ones, backs up settings.json first, and preserves the user's status line by
# chaining to it from dms-agent-statusline.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
hook="$here/dms-agent-hook"
sline="$here/dms-agent-statusline"
cfg=$HOME/.claude/settings.json
state=${XDG_STATE_HOME:-$HOME/.local/state}/dms-agent
mkdir -p "$state" "$(dirname "$cfg")"
[ -f "$cfg" ] || echo '{}' > "$cfg"
cp "$cfg" "$cfg.dms-backup"

# strip every hook entry pointing at dms-agent-hook (shared by both paths)
strip='.hooks = ((.hooks // {})
  | with_entries(.value |= (map(.hooks |= map(select((.command // "") | contains("dms-agent-hook") | not)))
                            | map(select((.hooks | length) > 0))))
  | with_entries(select((.value | length) > 0)))
  | (if .hooks == {} then del(.hooks) else . end)'

if [ "${1:-}" = "--uninstall" ]; then
    orig=$(cat "$state/statusline-orig" 2>/dev/null || true)
    jq --arg orig "$orig" "$strip"'
      | (if ((.statusLine.command // "") | contains("dms-agent-statusline")) then
             (if $orig == "" then del(.statusLine) else .statusLine.command = $orig end)
         else . end)' "$cfg" > "$cfg.tmp" && mv "$cfg.tmp" "$cfg"
    echo "dms-agent integration removed from $cfg"
    exit 0
fi

# remember the user's status line so ours can chain to it (never wrap our own)
cur=$(jq -r '.statusLine.command // ""' "$cfg")
case "$cur" in
*dms-agent-statusline*) ;;
*) printf '%s' "$cur" > "$state/statusline-orig" ;;
esac

jq --arg h "$hook" --arg s "$sline" "$strip"'
  | .hooks.SessionStart      = ((.hooks.SessionStart // [])      + [{hooks:[{type:"command", command:($h + " SessionStart"), async:true}]}])
  | .hooks.SessionEnd        = ((.hooks.SessionEnd // [])        + [{hooks:[{type:"command", command:($h + " SessionEnd"), async:true}]}])
  | .hooks.UserPromptSubmit  = ((.hooks.UserPromptSubmit // [])  + [{hooks:[{type:"command", command:($h + " UserPromptSubmit"), async:true}]}])
  | .hooks.PostToolUse       = ((.hooks.PostToolUse // [])       + [{matcher:"*", hooks:[{type:"command", command:($h + " PostToolUse"), async:true}]}])
  | .hooks.Stop              = ((.hooks.Stop // [])              + [{hooks:[{type:"command", command:($h + " Stop"), async:true}]}])
  | .hooks.Notification      = ((.hooks.Notification // [])      + [{hooks:[{type:"command", command:($h + " Notification"), async:true}]}])
  | .hooks.PermissionRequest = ((.hooks.PermissionRequest // []) + [{matcher:"*", hooks:[{type:"command", command:($h + " PermissionRequest"), timeout:600}]}])
  | .hooks.PreToolUse        = ((.hooks.PreToolUse // [])        + [{matcher:"AskUserQuestion", hooks:[{type:"command", command:($h + " PreToolUse"), timeout:600}]}])
  | .statusLine = {type:"command", command:$s}
' "$cfg" > "$cfg.tmp" && mv "$cfg.tmp" "$cfg"
echo "dms-agent hooks installed into $cfg (backup: $cfg.dms-backup)"

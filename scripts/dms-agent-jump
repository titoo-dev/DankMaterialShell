#!/usr/bin/env bash
# dms-agent-jump PID... — focus the compositor window owning any given pid
# (an agent session's terminal, resolved from its /proc ancestor chain).
# ponytail: Hyprland only — add a niri branch if anyone runs this there.
[ $# -gt 0 ] || exit 0
pids=$(printf '%s,' "$@")
addr=$(hyprctl clients -j 2>/dev/null \
    | jq -r --argjson p "[${pids%,}]" \
        '[.[] | select(.pid as $x | $p | index($x))][0].address // empty')
[ -n "$addr" ] && exec hyprctl dispatch focuswindow "address:$addr"
exit 1
